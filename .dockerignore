# Only application source, manifests, migrations and license material enter the context.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.json
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!apps/
!apps/**
!packages/
!packages/**
!scripts/
!scripts/**
!migrations/
!migrations/**
!licenses/
!licenses/**
!patches/
!patches/**

# Re-exclude generated/private files even when nested inside an allowed source tree.
**/node_modules
**/dist
**/build
**/coverage
**/.cache
**/.git
**/.codex-temp
**/.ssh
**/.aws
**/.kube
**/id_rsa*
**/id_ed25519*
**/.env
**/.env.*
**/data
**/storage
**/uploads
**/backups
**/output
**/tmp
**/test-results
**/playwright-report
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.dump
**/*.sqlite*
**/*.db
**/*.db-*
**/*.sql.gz
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
