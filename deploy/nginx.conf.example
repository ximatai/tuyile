# Host Nginx vhost template. Replace the hostname and provision certificates.
server {
    listen 80;
    server_name tuyile.example;
    return 308 https://tuyile.example$request_uri;
}

server {
    listen 443 ssl;
    server_name tuyile.example;
    ssl_certificate /etc/nginx/tls/tuyile.crt;
    ssl_certificate_key /etc/nginx/tls/tuyile.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8792;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
